#!/usr/bin/env bash
# Write the net change from a recorded BASE, including multi-commit tasks.
# Git endpoints are commits; jj endpoints can include the working copy (@).
# Usage: review-package BASE HEAD [OUTFILE]
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

scripts=$(cd "$(dirname "$0")" && pwd)
source "$scripts/vcs.sh"
sdd_repo

resolve_revision() {
  local id
  if [ "$vcs" = jj ]; then
    id=$(jj --color never log --no-graph -r "$1" -T 'commit_id ++ "\n"') || return
  else
    id=$(git rev-parse --verify --end-of-options "$1^{commit}") || return
  fi
  # Reject empty and multi-revision revsets before creating a package.
  [[ "$id" =~ ^[0-9a-f]{40,64}$ ]] || return 1
  printf '%s\n' "$id"
}

base=$(resolve_revision "$1") || { echo "bad BASE: $1" >&2; exit 2; }
head=$(resolve_revision "$2") || { echo "bad HEAD: $2" >&2; exit 2; }

if [ $# -eq 3 ]; then
  case "$3" in
    /*) out=$3 ;;
    *) out="$PWD/$3" ;;
  esac
else
  dir=$("$scripts/sdd-workspace")
  out="$dir/review-${base:0:12}..${head:0:12}.diff"
fi

# Publish only a complete package; a failed command must not erase old evidence.
tmp=$(mktemp "$out.tmp.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cd "$root"
{
  echo "# Review package: ${base}..${head} ($vcs)"
  echo
  echo "## Commits"
  if [ "$vcs" = jj ]; then
    jj --ignore-working-copy --color never log --no-graph -r "$base..$head" \
      -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"'
  else
    git --no-pager log --no-color --oneline "$base..$head"
  fi
  echo
  echo "## Files changed"
  if [ "$vcs" = jj ]; then
    jj --ignore-working-copy --color never diff --from "$base" --to "$head" --stat
  else
    git --no-pager diff --no-ext-diff --no-textconv --stat "$base" "$head"
  fi
  echo
  echo "## Diff"
  if [ "$vcs" = jj ]; then
    jj --ignore-working-copy --color never diff --from "$base" --to "$head" --git --context 10
  else
    git --no-pager diff --no-color --no-ext-diff --no-textconv -U10 "$base" "$head"
  fi
} > "$tmp"
mv "$tmp" "$out"
echo "wrote ${out}: $(wc -c < "$out" | tr -d ' ') bytes"
